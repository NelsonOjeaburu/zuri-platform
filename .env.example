# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed — see .gitignore.
# This is exactly the mistake in Zuri's case study (Section 2.3 of the brief):
# a real .env got committed to Git and pasted into Slack. Don't repeat it.

API_SECRET_KEY=replace-with-a-local-dev-only-key
STORE_NAME=Zuri Market
